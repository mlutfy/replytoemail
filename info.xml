<?xml version="1.0"?>
<extension key="biz.jmaconsulting.replytoemail" type="module">
  <file>replytoemail</file>
  <name>Reply to Inbound Email</name>
  <description>This extension provides the functionality to reply to an inbound email or archive it.</description>
  <license>AGPL-3.0</license>
  <maintainer>
    <author>Edsel Lopez</author>
    <email>edsel.lopez@jmaconsulting.biz</email>
  </maintainer>
  <urls>
    <url desc="Main Extension Page">https://github.com/JMAConsulting/biz.jmaconsulting.replytoemail</url>
    <url desc="Documentation">https://github.com/JMAConsulting/biz.jmaconsulting.replytoemail/wiki</url>
    <url desc="Support">https://github.com/JMAConsulting/biz.jmaconsulting.replytoemail/issues</url>
    <url desc="Licensing">http://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2021-02-19</releaseDate>
  <version>1.78</version>
  <develStage>alpha</develStage>
  <compatibility>
    <ver>5.38</ver>
  </compatibility>
  <comments>This is a new, undeveloped module</comments>
  <classloader>
    <psr4 prefix="Civi\" path="Civi"/>
    <psr0 prefix="CRM_" path="."/>
  </classloader>
  <civix>
    <namespace>CRM/Replytoemail</namespace>
    <format>24.09.1</format>
  </civix>
  <mixins>
    <mixin>menu-xml@1.0.0</mixin>
    <mixin>smarty-v2@1.0.3</mixin>
  </mixins>
  <upgrader>CRM_Replytoemail_Upgrader</upgrader>
</extension>
